@inject SettingsService Settings
@inject NavigationManager Navigation
@inject PauseState Pause
@inject ProgressService Progress
@inject FullscreenService Fullscreen
@implements IDisposable

<CornerButton OnClick="Open" />

@if (_open)
{
    <div class="parent-panel" role="dialog" aria-label="Grown-ups">
        <button class="panel-button" @onclick="ToggleSound">@(_settings.Sound ? "🔊 Sound on" : "🔇 Sound off")</button>
        <button class="panel-button" @onclick="ToggleSpeech">@(_settings.Speech ? "🗣️ Speech on" : "🤐 Speech off")</button>
        <button class="panel-button" @onclick="ToggleFullscreen">@(_settings.Fullscreen ? "⛶ Fullscreen on" : "⛶ Fullscreen off")</button>
        @if (_hardcore)
        {
            <button class="panel-button" disabled>🔥 Hardcore Mode on (reset levels to end it)</button>
        }
        else
        {
            <button class="panel-button" @onclick="ToggleHardcore">@(_confirmingHardcore ? "⚠️ Restarts from level 1 and can't be undone until levels are reset. Tap again to start" : "🔥 Hardcore Mode")</button>
        }
        <button class="panel-button" @onclick="GoOptions">⚙️ Options</button>
        <button class="panel-button" @onclick="GoHome">🏠 Exit to menu</button>
        <button class="panel-button" @onclick="Close">✖ Close</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public string GameId { get; set; } = "";

    private bool _open, _hardcore, _confirmingHardcore;
    private GameSettings _settings = new();

    private async Task Open()
    {
        _settings = await Settings.GetAsync();
        _hardcore = await Progress.IsHardcoreAsync(GameId);
        _confirmingHardcore = false;
        _open = true;
        Pause.Set(true); // the game's countdown stands still while the menu is open
    }

    private Task ToggleSound() => Update(s => s with { Sound = !s.Sound });

    private async Task ToggleFullscreen()
    {
        await Fullscreen.SetAsync(!_settings.Fullscreen);
        _settings = await Settings.GetAsync();
    }

    private Task ToggleSpeech() => Update(s => s with { Speech = !s.Speech });

    /// <summary>Hardcore Mode can't be switched off again (only by resetting the levels), so the first tap only asks.</summary>
    private void ToggleHardcore()
    {
        if (!_confirmingHardcore) { _confirmingHardcore = true; return; }
        _confirmingHardcore = false;
        _hardcore = true;
        Progress.RequestHardcore(GameId);
    }

    private async Task Update(Func<GameSettings, GameSettings> change)
    {
        await Settings.UpdateAsync(change);
        _settings = await Settings.GetAsync();
    }

    private void GoOptions() => Navigation.NavigateTo("options");

    private void GoHome() => Navigation.NavigateTo("");

    private void Close()
    {
        _open = false;
        Pause.Set(false);
    }

    public void Dispose() => Pause.Set(false);
}
