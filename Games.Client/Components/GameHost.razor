@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject SettingsService Settings
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject PauseState Pause
@inject ProgressService Progress

<div @ref="_container" class="game-container"></div>

@code {
    private ElementReference _container;
    private IJSObjectReference? _host;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<GameHost>? _self;
    private GameInfo? _mounted;

    [Parameter, EditorRequired] public GameInfo Game { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mounted == Game) return;
        _mounted = Game;
        await UnmountAsync();

        _host ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/host.js");
        _self ??= DotNetObjectReference.Create(this);
        Settings.Changed -= OnSettingsChanged;
        Settings.Changed += OnSettingsChanged;
        Pause.Changed -= OnPauseChanged;
        Pause.Changed += OnPauseChanged;
        Progress.HardcoreRequested -= OnHardcoreRequested;
        Progress.HardcoreRequested += OnHardcoreRequested;
        _handle = await _host.InvokeAsync<IJSObjectReference>(
            "mountGame", Game.Id, Game.Module, _container, await Settings.GetAsync(), _self, HostEnvironment.IsDevelopment());
    }

    private async void OnSettingsChanged()
    {
        if (_host is null || _handle is null) return;
        await _host.InvokeVoidAsync("updateGame", _handle, await Settings.GetAsync());
    }

    private async void OnPauseChanged()
    {
        if (_host is null || _handle is null) return;
        await _host.InvokeVoidAsync("pauseGame", _handle, Pause.Paused);
    }

    private async void OnHardcoreRequested(string gameId)
    {
        if (_host is null || _handle is null || gameId != Game.Id) return;
        await _host.InvokeVoidAsync("hardcoreGame", _handle);
    }

    [JSInvokable] public void Exit() => Navigation.NavigateTo("");

    [JSInvokable] public void Rewarded(int stars) { /* the game stores its own progress; hook for shell-level rewards */ }

    private async Task UnmountAsync()
    {
        if (_host is not null && _handle is not null)
        {
            await _host.InvokeVoidAsync("unmountGame", _handle);
            await _handle.DisposeAsync();
        }
        _handle = null;
    }

    public async ValueTask DisposeAsync()
    {
        Settings.Changed -= OnSettingsChanged;
        Pause.Changed -= OnPauseChanged;
        Progress.HardcoreRequested -= OnHardcoreRequested;
        try
        {
            await UnmountAsync();
            if (_host is not null) await _host.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
